FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir esptool==5.6.0
COPY firmware/esp32-companion/dist /firmware
RUN python -c "import hashlib,json,pathlib; p=pathlib.Path('/firmware'); m=json.loads((p/'manifest.json').read_text()); assert all(hashlib.sha256((p/n).read_bytes()).hexdigest()==h for n,h in m['sha256'].items()), 'Firmware checksum mismatch'"
ENTRYPOINT ["python", "-m", "esptool", "--chip", "esp32", "--port", "/dev/esp32"]
CMD ["write-flash", "0x0", "/firmware/factory.bin"]
